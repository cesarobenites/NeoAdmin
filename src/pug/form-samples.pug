extends layouts/_admin.pug

block head
  - var title = "Form Samples"
  - var activePage = "form-samples"

block content
  .app-title
    div
      h1.fs-3.fs-md-2
        i.bi.bi-pencil-square.me-2
        | Form Samples
      p.text-muted.mb-0 Sample form layouts and structures

    ul.app-breadcrumb.breadcrumb.d-none.d-md-flex
      li.breadcrumb-item
        i.bi.bi-house-door.fs-6
      li.breadcrumb-item Forms
      li.breadcrumb-item.active
        a(href="#") Sample Forms

  .row.g-3
    .col-md-6
      .tile
        h3.tile-title Vertical Form
        .tile-body
          form
            +input('Name', 'name', 'text', '', 'Enter full name')
            +input('Email', 'email', 'email', '', 'Enter email address')
            .mb-3
              label.form-label.fw-semibold Address
              textarea.form-control(rows="4", placeholder="Enter your address")

            .mb-3
              label.form-label.fw-semibold Gender
              .form-check
                input.form-check-input#genderMale(type="radio", name="gender")
                label.form-check-label(for="genderMale") Male
              .form-check
                input.form-check-input#genderFemale(type="radio", name="gender")
                label.form-check-label(for="genderFemale") Female

            .mb-3
              label.form-label.fw-semibold Identity Proof
              input.form-control(type="file")

            .mb-3
              .form-check
                input.form-check-input#acceptTerms(type="checkbox")
                label.form-check-label(for="acceptTerms") I accept the terms and conditions

            .tile-footer
              button.btn.btn-primary.me-2(type="button")
                i.bi.bi-check-circle-fill.me-2
                | Register
              button.btn.btn-secondary(type="button")
                i.bi.bi-x-circle-fill.me-2
                | Cancel

    .col-md-6
      .tile
        h3.tile-title Horizontal Register Form
        .tile-body
          form.form-horizontal
            .mb-3.row
              label.form-label.col-md-3.fw-semibold Name
              .col-md-8
                input.form-control(type="text", placeholder="Enter full name")

            .mb-3.row
              label.form-label.col-md-3.fw-semibold Email
              .col-md-8
                input.form-control(type="email", placeholder="Enter email address")

            .mb-3.row
              label.form-label.col-md-3.fw-semibold Address
              .col-md-8
                textarea.form-control(rows="4", placeholder="Enter your address")

            .mb-3.row
              label.form-label.col-md-3.fw-semibold Gender
              .col-md-9
                .form-check
                  input.form-check-input#genderMale2(type="radio", name="gender2")
                  label.form-check-label(for="genderMale2") Male
                .form-check
                  input.form-check-input#genderFemale2(type="radio", name="gender2")
                  label.form-check-label(for="genderFemale2") Female

            .mb-3.row
              label.form-label.col-md-3.fw-semibold Identity Proof
              .col-md-8
                input.form-control(type="file")

            .mb-3.row
              .col-md-8.offset-md-3
                .form-check
                  input.form-check-input#acceptTerms2(type="checkbox")
                  label.form-check-label(for="acceptTerms2") I accept the terms and conditions

            .tile-footer
              .row
                .col-md-8.offset-md-3
                  button.btn.btn-primary.me-2(type="button")
                    i.bi.bi-check-circle-fill.me-2
                    | Register
                  button.btn.btn-secondary(type="button")
                    i.bi.bi-x-circle-fill.me-2
                    | Cancel

    .col-12
      .tile
        h3.tile-title Subscribe
        .tile-body
          form.row.g-3.align-items-end
            .col-md-4
              +input('Name', 'subName', 'text', '', 'Enter your name')
            .col-md-4
              +input('Email', 'subEmail', 'email', '', 'Enter your email')
            .col-md-4
              button.btn.btn-primary.mb-3(type="button")
                i.bi.bi-check-circle-fill.me-2
                | Subscribe
