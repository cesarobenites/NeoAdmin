extends layouts/_admin.pug

block head
  - var title = "Basic Tables"
  - var activePage = "table-basic"

block content
  .app-title
    div
      h1.fs-3.fs-md-2
        i.bi.bi-table.me-2
        | Basic Tables
      p.text-muted.mb-0 Basic bootstrap tables

    ul.app-breadcrumb.breadcrumb.d-none.d-md-flex
      li.breadcrumb-item
        i.bi.bi-house-door.fs-6
      li.breadcrumb-item Tables
      li.breadcrumb-item.active
        a(href="#") Simple Tables

  .row.g-3
    .col-12.col-md-6
      .tile
        h3.tile-title Simple Table
        .table-responsive
          table.table
            thead
              tr
                th #
                th First Name
                th Last Name
                th Username
            tbody
              tr
                td 1
                td Mark
                td Otto
                td @mdo
              tr
                td 2
                td Jacob
                td Thornton
                td @fat
              tr
                td 3
                td Larry
                td the Bird
                td @twitter

    .col-12.col-md-6
