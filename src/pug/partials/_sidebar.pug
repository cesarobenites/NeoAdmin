aside.app-sidebar
  .sidebar-scroll.sidebar-scroll-toggled
    .app-sidebar__user
      img.app-sidebar__user-avatar-mobile(src="assets/images/avatar.jpg", alt="User Image")
      img.app-sidebar__user-avatar(src="assets/images/avatar_128.jpg", alt="User Image")
      div
        p.app-sidebar__user-name César Rolando
        p.app-sidebar__user-designation Software Developer

    ul.app-menu
      li
        a.app-menu__item(href="dashboard.html", class=(activePage === 'dashboard' ? 'active' : ''))
          i.app-menu__icon.bi.bi-house-door
          span.app-menu__label Dashboard

      li.treeview(class=(['bootstrap-components', 'cards', 'widgets', 'ui-dates'].includes(activePage) ? 'is-expanded' : ''))
        a.app-menu__item(href="#", data-neoadmin-treeview)
          i.app-menu__icon.bi.bi-laptop
          span.app-menu__label UI Elements
          i.treeview-indicator.bi.bi-chevron-right
        ul.treeview-menu
          li
            a.treeview-item(href="bootstrap-components.html", class=(activePage === 'bootstrap-components' ? 'active' : ''))
